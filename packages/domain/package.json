{
  "name": "@spliit/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./account-preferences": "./src/account-preferences.ts",
    "./activities": "./src/activities/index.ts",
    "./balances": "./src/balances.ts",
    "./currency": "./src/currency.ts",
    "./i18n": "./src/i18n.ts",
    "./notifications": "./src/notifications.ts",
    "./password": "./src/password.ts",
    "./recurring-expenses": "./src/recurring-expenses.ts",
    "./schemas": "./src/schemas.ts",
    "./subgroup-settlements": "./src/subgroup-settlements.ts",
    "./totals": "./src/totals.ts",
    "./timezones": "./src/timezones.ts",
    "./utils": "./src/utils.ts",
    "./calculator": "./src/calculator.ts",
    "./export-manifest": "./src/export-manifest.ts",
    "./import": "./src/import/index.ts",
    "./notification-delivery": "./src/notification-delivery.ts"
  },
  "scripts": {
