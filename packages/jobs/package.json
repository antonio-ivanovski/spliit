{
  "name": "@spliit/jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./registry": "./src/registry.ts",
    "./boss": "./src/boss.ts",
    "./lifecycle": "./src/lifecycle.ts"
  },
  "scripts": {
    "check-formatting": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "format": "oxfmt .",
    "lint": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives --fix .",
    "test": "vitest run src"
  },
  "dependencies": {
    "pg-boss": "12.26.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@spliit/config": "workspace:*",
    "@types/node": "24.13.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
