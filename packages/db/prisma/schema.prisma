// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

generator json {
  provider = "prisma-json-types-generator"
}

generator dmmf {
  provider = "prisma-mock"
  output   = "../src/generated/prisma/dmmf.ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth & accounts
//
// better-auth owns four core tables: user, session, account, verification.
// We rename them to Spliit concepts via the better-auth `modelName` option:
//   - better-auth "user"        -> Account  (stable global user profile)
//   - better-auth "session"     -> Session  (server-recognized sessions)
//   - better-auth "account"     -> AuthIdentity (provider identity records)
//   - better-auth "verification"-> Verification (magic-link/email tokens)
//
// Field names match what better-auth expects by default so the Prisma adapter
// can read/write without a field mapping.
// ---------------------------------------------------------------------------

model Account {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  isAnonymous   Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authIdentities     AuthIdentity[]
  sessions           Session[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  groupMemberships              GroupMember[]
  // Invitations this account has been the target of (accepted-by).
  receivedInvitations           GroupInvitation[]               @relation("InvitationInviteeAccount")
  // Invitations this account has issued as an owner/admin.
  sentInvitations               GroupInvitation[]               @relation("InvitationInviter")
  groupPreferences              AccountGroupPreference[]
  personalSplitPresets          SplitPreset[]                  @relation("PersonalSplitPresetOwner")
  savedViews                    AccountSavedView[]
  preference                    AccountPreference?
  pushSubscriptions             PushSubscription[]
  notificationPreferences       AccountNotificationPreference[]
  notificationDeliveries        NotificationDelivery[]
  anonymousRecoveryCredential   AnonymousRecoveryCredential?
  recurringExpenseSeriesCreated RecurringExpenseSeries[]        @relation("RecurringExpenseSeriesCreator")
  expensesCreated               Expense[]                       @relation("ExpenseCreator")
  expenseComments               ExpenseComment[]
  idempotencyRequests           IdempotencyRequest[]
}

model AnonymousRecoveryCredential {
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId             String    @id
  keyHash               String    @unique
  pendingKeyCiphertext  String?
  acknowledgedAt        DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model IdempotencyRequest {
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  operation   String
  requestId   String    @db.Uuid
  requestHash String
  result      Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@id([accountId, operation, requestId])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

// Account-scoped notification channel preferences. Categories and channel
// values are validated by the shared domain package and intentionally remain
// strings in the database so adding a category/channel does not require a
// Prisma enum migration.
model AccountNotificationPreference {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  // Notification category validated by @spliit/domain at API boundaries.
  category  String
  /// ![NotificationChannel]
  channels  String[]

  @@unique([accountId, category])
  @@index([accountId])
}

model AuthIdentity {
  id                    String    @id
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // Trusted identity namespace. Credential accounts use `local:credential`;
  // Google uses `https://accounts.google.com`; OAuth providers without an
  // issuer use `local:oauth:<providerId>`.
  issuer                String
  // Provider identity: "credential" (email/password), "magic-link", or a social
  // provider id such as "google".
  providerId            String
  // The provider-specific account id (e.g. Google sub, or the Account id for
  // credential identities).
  accountId             String
  // Refers to the owning Spliit account (better-auth "user").
  account               Account   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Hashed password, only populated for the "credential" provider.
  password              String?

  @@unique([issuer, accountId])
  @@index([userId])
}

model Session {
  id                 String              @id
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  // The signed-in account this session belongs to.
  account            Account             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  expiresAt          DateTime
  token              String              @unique
  ipAddress          String?
  userAgent          String?
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
}

model OauthClient {
  id                              String                @id
  clientId                        String                @unique
  clientSecret                    String?
  clientDiscoveryId               String?
  disabled                        Boolean?              @default(false)
  skipConsent                     Boolean?
  enableEndSession                Boolean?
  subjectType                     String?
  scopes                          String[]              @default([])
  clientCredentialsScopes         String[]              @default([])
  userId                          String?
  account                         Account?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                       DateTime?
  updatedAt                       DateTime?
  name                            String?
  uri                             String?
  icon                            String?
  contacts                        String[]              @default([])
  tos                             String?
  policy                          String?
  softwareId                      String?
  softwareVersion                 String?
  softwareStatement               String?
  redirectUris                    String[]
  postLogoutRedirectUris          String[]              @default([])
  backchannelLogoutUri            String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod         String?
  applicationType                 String?
  jwks                            String?
  jwksUri                         String?
  grantTypes                      String[]              @default([])
  responseTypes                   String[]              @default([])
  requirePKCE                     Boolean?
  dpopBoundAccessTokens           Boolean?              @default(false)
  referenceId                     String?
  metadata                        Json?
  oauthRefreshTokens              OauthRefreshToken[]
  oauthAccessTokens               OauthAccessToken[]
  oauthConsents                   OauthConsent[]
  oauthClientResources            OauthClientResource[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                           String                @id
  identifier                   String                @unique
  name                         String
  accessTokenTtl               Int?
  refreshTokenTtl              Int?
  signingAlgorithm             String?
  signingKeyId                 String?
  /// Null means inherit plugin-level scope policy. An empty list would deny every scope.
  allowedScopes                Json?
  customClaims                 Json?
  dpopBoundAccessTokensRequired Boolean?             @default(false)
  disabled                     Boolean?              @default(false)
  createdAt                    DateTime?
  updatedAt                    DateTime?
  policyVersion                Int?                  @default(1)
  metadata                     Json?
  oauthClientResources         OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id
  clientId      String
  oauthClient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthResource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                       String             @id
  token                    String             @unique
  clientId                 String
  oauthClient              OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId                String?
  session                  Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                   String
  account                  Account            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId              String?
  authorizationCodeId      String?
  resources                String[]           @default([])
  requestedUserInfoClaims  String[]           @default([])
  expiresAt                DateTime?
  createdAt                DateTime?
  revoked                  DateTime?
  rotatedAt                DateTime?
  rotationReplayResponse   String?
  rotationReplayExpiresAt  DateTime?
  authTime                 DateTime?
  confirmation             Json?
  scopes                   String[]
  oauthAccessTokens        OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                       String             @id
  token                    String?            @unique
  clientId                 String
  oauthClient              OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId                String?
  session                  Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                   String?
  account                  Account?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId              String?
  authorizationCodeId      String?
  resources                String[]           @default([])
  requestedUserInfoClaims  String[]           @default([])
  refreshId                String?
  oauthRefreshToken        OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt                DateTime?
  createdAt                DateTime?
  revoked                  DateTime?
  confirmation             Json?
  scopes                   String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@index([authorizationCodeId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                       String      @id
  clientId                 String
  oauthClient              OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                   String?
  account                  Account?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId              String?
  resources                String[]           @default([])
  requestedUserInfoClaims  String[]           @default([])
  scopes                   String[]
  createdAt                DateTime?
  updatedAt                DateTime?

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model Verification {
  id         String   @id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  value      String
  expiresAt  DateTime
  identifier String

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Ledger accounting core
//
// Every group (and, in the future, every direct account relationship) has one
// Ledger. Expenses, balances, activities, documents, recurrence, exports, and
// base currency attach to the Ledger rather than the group product container.
// ---------------------------------------------------------------------------

model Ledger {
  id           String   @id
  // The base currency of the ledger. `currency` is the display symbol (e.g. "$"),
  // `currencyCode` is the ISO-4217 code (e.g. "USD") or null for custom currencies.
  currency     String   @default("$")
  currencyCode String?
  createdAt    DateTime @default(now())

  participants           LedgerParticipant[]
  expenses               Expense[]
  activities             Activity[]
  documents              ExpenseDocument[]        @relation("LedgerDocuments")
  recurringExpenseSeries RecurringExpenseSeries[]

  group   Group?
  budgets GroupBudget[]
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum BudgetScopeMode {
  ALL
  SELECTED
}

model GroupBudget {
  id                 String             @id
  group              Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId            String
  ledger             Ledger             @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ledgerId           String
  name               String
  amount             Int
  period             BudgetPeriod
  timeZone           String             @default("UTC")
  customStartDate    DateTime?          @db.Date
  customEndDate      DateTime?          @db.Date
  categoryScope      BudgetScopeMode    @default(ALL)
  categoryNodeIds    String[]           @default([])
  participantScope   BudgetScopeMode    @default(ALL)
  participantIds     String[]           @default([])
  notifyTrending     Boolean            @default(true)
  notifyOver         Boolean            @default(true)
  archived           Boolean            @default(false)
  archivedAt         DateTime?
  createdByAccountId String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  alerts             GroupBudgetAlert[]

  @@index([groupId, archived])
  @@index([ledgerId, archived])
}

enum BudgetAlertType {
  TRENDING_OVER
  OVER
}

model GroupBudgetAlert {
  id          String          @id
  budget      GroupBudget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId    String
  periodStart DateTime        @db.Date
  alertType   BudgetAlertType
  createdAt   DateTime        @default(now())
  deliveredAt DateTime?

  @@unique([budgetId, periodStart, alertType])
  @@index([budgetId, periodStart])
}

enum LedgerParticipantKind {
  // Account-backed group member. `groupMemberId` is non-null and the
  // display name resolves through the `Account.name` relation.
  ACCOUNT_MEMBER
  // Name-only entry that has no account and no app access. `groupMemberId`
  // is null and `displayName` carries the human-readable label. Used
  // exclusively for imported groups: a one-way admin link migrates an
  // unlinked entry to ACCOUNT_MEMBER.
  UNLINKED_PARTICIPANT
}

model LedgerParticipant {
  id            String                @id
  ledger        Ledger                @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ledgerId      String
  // Backing group membership, if this participant is an account-backed group member.
  groupMember   GroupMember?          @relation(fields: [groupMemberId], references: [id])
  groupMemberId String?               @unique
  // Discriminator between account-backed and name-only participants.
  // Default is ACCOUNT_MEMBER. UNLINKED_PARTICIPANT rows are created by
  // imports or by the name-only participant flow.
  kind          LedgerParticipantKind @default(ACCOUNT_MEMBER)
  // Display label for UNLINKED_PARTICIPANT rows. Required by a database check
  // for that kind; null for account-backed rows (the display name is resolved
  // through `groupMember.account.name`).
  displayName   String?
  // Soft-hide timestamp. When set, the participant is excluded from Members
  // lists and expense pickers but expense history is preserved.
  removedAt     DateTime?

  expensesPaidByList              ExpensePaidBy[]
  expensesPaidFor                 ExpensePaidFor[]
  expenseItemPaidFor              ExpenseItemPaidFor[]
  expenseItemizedRemainderPaidFor ExpenseItemizedRemainderPaidFor[]
  splitPresetParticipants         SplitPresetParticipant[]
  // Pending invitations that materialized this ledger participant to allow
  // pre-accept expenses. The link is cleared when the invitation is revoked.
  invitations                     GroupInvitation[]
  subgroupMembership              SubgroupMember?

  @@index([ledgerId])
}

// ---------------------------------------------------------------------------
// Groups, memberships, invitations
// ---------------------------------------------------------------------------

enum GroupType {
  // Regular multi-member group with a user-supplied name. The default for
  // groups created via `groups.create`.
  GROUP
  // Two-person friend ledger. The group's `name` is empty; the UI surfaces
  // a per-viewer `displayName` resolved from the other member's account.
  // Friend ledgers carry additional server-side restrictions.
  FRIEND
}

model Group {
  id          String    @id
  name        String
  information String?   @db.Text
  // Group-level archive flag. When true, the group is read-only for all
  // members (no new expenses can be added) and it appears in the "Archived"
  // section of every member's group list. The setting is owned by
  // OWNER/ADMIN through the `groups.archive` tRPC mutation. This is
  // distinct from the per-account `AccountGroupPreference.archived` column
  // — see that model for the rename history.
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  // Discriminates regular multi-member groups (`GROUP`) from two-person
  // friend ledgers (`FRIEND`). Friend ledgers carry additional server-side
  // restrictions (no rename, no archive, no leave, etc.) and feed the
  // separate Friends homepage section.
  groupType   GroupType @default(GROUP)

  // One group has exactly one ledger that holds its accounting core.
  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ledgerId String @unique

  members            GroupMember[]
  invitations        GroupInvitation[]
  // Bearer secret for the optional Public View-only link. Null means public
  // access is unavailable; replacing/removing it invalidates the link.
  publicViewKey      String?                    @unique
  accountPreferences AccountGroupPreference[]
  savedViews         AccountSavedView[]
  splitPresets       SplitPreset[]
  defaultPaidByPreset   SplitPreset? @relation("GroupDefaultPaidBy", fields: [defaultPaidByPresetId], references: [id], onDelete: SetNull)
  defaultPaidByPresetId String?
  defaultPaidForPreset   SplitPreset? @relation("GroupDefaultPaidFor", fields: [defaultPaidForPresetId], references: [id], onDelete: SetNull)
  defaultPaidForPresetId String?
  budgets            GroupBudget[]
  subgroupsEnabled   Boolean                    @default(false)
  subgroups          Subgroup[]
  // Two-person friend ledgers: the unordered account pair key stored as
  // "accountAId:accountBId" where accountAId < accountBId. Null during the
  // pending-invitation window (peer hasn't joined yet), populated on accept.
  // A partial unique index guarantees at most one FRIEND group per pair.
  friendPairKey      String?
}

model Subgroup {
  id        String   @id
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members SubgroupMember[]

  @@unique([groupId, name])
  @@index([groupId, createdAt])
}

model SubgroupMember {
  subgroup            Subgroup          @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  subgroupId          String
  ledgerParticipant   LedgerParticipant @relation(fields: [ledgerParticipantId], references: [id], onDelete: Cascade)
  ledgerParticipantId String            @unique

  @@id([subgroupId, ledgerParticipantId])
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum GroupMemberStatus {
  PENDING
  ACTIVE
  LEFT
  REMOVED
  SUSPENDED
}

model GroupMember {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  role      GroupRole         @default(MEMBER)
  status    GroupMemberStatus @default(ACTIVE)

  joinedAt DateTime?
  leftAt   DateTime?

  // The ledger participant that represents this member in expenses/balances.
  // Null until a ledger participant has been materialized for this member.
  ledgerParticipant LedgerParticipant?

  @@unique([groupId, accountId])
  @@index([accountId])
  @@index([accountId, status])
}

enum GroupInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum GroupInvitationType {
  // Targeted invite for a specific account by email. Acceptance requires
  // the authenticated account's email to match `email` case-insensitively.
  EMAIL
  // Shareable invite intended to be claimed by anyone with the link.
  // The `email` column is still populated, but as a unique synthetic
  // placeholder of the form `${token}@link.placeholder.local` (the
  // `.placeholder.local` suffix is the signal for "not a real address";
  // see `lib/invitations.ts` for the generator). Acceptance is gated on
  // the synthetic match rather than an account email match.
  LINK
}

model GroupInvitation {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  type GroupInvitationType @default(EMAIL)

  // Email the invitation targets. For `EMAIL` invitations this is the
  // recipient's real address; for `LINK` invitations it is a unique
  // synthetic placeholder under the `.placeholder.local` reserved
  // domain (so the global unique constraint stays the source of
  // identity and the column is always non-null).
  email String

  // Optional pending-only label. When set, the UI surfaces this name
  // (e.g. in the participant picker, expense cards, and activity feed)
  // instead of the raw email while the invitation is still PENDING.
  // After acceptance, the account profile (`Account.name`) wins.
  // Accepted invitations keep this column populated for historical reads.
  temporaryName String?

  role   GroupRole             @default(MEMBER)
  status GroupInvitationStatus @default(PENDING)

  // The inviter (owner/admin who created the invitation).
  invitedBy   Account @relation("InvitationInviter", fields: [invitedById], references: [id])
  invitedById String

  // The account that accepted the invitation, once accepted.
  acceptedBy   Account?  @relation("InvitationInviteeAccount", fields: [acceptedById], references: [id])
  acceptedById String?
  acceptedAt   DateTime?
  revokedAt    DateTime?

  // Link-invite fields (populated only when `type = LINK`).
  // `tokenHash` is a SHA-256 hash of the raw token. The raw token is
  // returned to the inviter exactly once at create time and is never
  // stored, so the link can be revoked or rotated without leaking the
  // original URL. `expiresAt` is optional: when set, the API rejects
  // accept attempts after that timestamp.
  tokenHash String?   @unique
  expiresAt DateTime?

  // Optional virtual LedgerParticipant materialized for this pending invitation
  // so expenses can be recorded against the invitee before they accept. The
  // link is created at invitation write time (email/link send) and populated
  // by the migration backfill for pre-existing rows; it is reused when the
  // invitation is accepted, and cleared on revoke.
  ledgerParticipant   LedgerParticipant? @relation(fields: [ledgerParticipantId], references: [id], onDelete: SetNull)
  ledgerParticipantId String?

  @@index([groupId])
  @@index([email])
  @@index([email, status])
  @@index([groupId, status])
}

// ---------------------------------------------------------------------------
// Account-level group preferences (server source of truth, cross-device)
// ---------------------------------------------------------------------------

model AccountPreference {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @unique

  // Values are validated against shared @spliit/domain schemas at API boundaries.
  defaultCurrencyCode String?
  timeZone            String?
  locale              String?
  theme               String?
  mascot              String  @default("bill")

  notificationsEnabled     Boolean  @default(true)
  aiFeaturesEnabled        Boolean  @default(true)
  aiCategoryExtractEnabled Boolean? @default(true)
  aiReceiptScanEnabled     Boolean? @default(true)
  aiVoiceExpenseEnabled    Boolean? @default(true)
}

model AccountGroupPreference {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String

  starred Boolean @default(false)
  // Per-account "hide" preference: removes the group from this user's list
  // without affecting other members. Distinct from `Group.archived`, the
  // group-level flag set by ADMIN/OWNER through the `groups.archive` mutation.
  hidden  Boolean @default(false)

  paidByDefaultMode SplitPresetDefaultMode @default(INHERIT)
  paidByDefaultPreset SplitPreset? @relation("AccountGroupDefaultPaidBy", fields: [paidByDefaultPresetId], references: [id], onDelete: SetNull)
  paidByDefaultPresetId String?
  paidForDefaultMode SplitPresetDefaultMode @default(INHERIT)
  paidForDefaultPreset SplitPreset? @relation("AccountGroupDefaultPaidFor", fields: [paidForDefaultPresetId], references: [id], onDelete: SetNull)
  paidForDefaultPresetId String?

  @@unique([accountId, groupId])
}

// Per-account bookmark of a public view-only group. Not membership: opening
// still requires `viewKey`. Replacing/removing the group's public key leaves
// this row in place until the account removes it.
model AccountSavedView {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String

  /// Stored in plaintext so the client can rebuild `?viewKey=`. Hashing is out of scope.
  viewKey      String
  lastOpenedAt DateTime

  @@unique([accountId, groupId])
  @@index([accountId, lastOpenedAt])
}

enum SplitPresetDefaultMode {
  INHERIT
  PRESET
  NEUTRAL
}

enum SplitPresetTarget {
  PAID_BY
  PAID_FOR
}

model SplitPreset {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  ownerAccount   Account? @relation("PersonalSplitPresetOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  ownerAccountId String?
  // GROUP for shared presets, ACCOUNT:<accountId> for personal presets.
  scopeKey  String
  name      String
  nameKey   String
  target    SplitPresetTarget
  splitMode SplitMode
  participants SplitPresetParticipant[]

  groupDefaultPaidBy  Group[] @relation("GroupDefaultPaidBy")
  groupDefaultPaidFor Group[] @relation("GroupDefaultPaidFor")
  accountDefaultPaidBy  AccountGroupPreference[] @relation("AccountGroupDefaultPaidBy")
  accountDefaultPaidFor AccountGroupPreference[] @relation("AccountGroupDefaultPaidFor")

  @@unique([groupId, scopeKey, nameKey])
  @@index([ownerAccountId, groupId])
}

model SplitPresetParticipant {
  preset        SplitPreset       @relation(fields: [presetId], references: [id], onDelete: Cascade)
  presetId      String
  participant   LedgerParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  participantId String
  shares        Int

  @@id([presetId, participantId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Expenses, splits, documents, activities, recurrence
// ---------------------------------------------------------------------------

// NOTE: There is no `Category` model on purpose. Default categories are
// defined in code (`packages/domain/src/categories.ts`) and resolved
// through i18n. `Expense.categoryId` stores a string id that is
// validated against `categoryIdSchema` (a Zod enum of the in-code ids).
// The column is intentionally not a foreign key: when user-created
// categories land, a new `Category` table will be re-introduced and a
// migration will restore the constraint.

// Null conversionSource on Expense = same currency (no conversion).
enum ConversionSource {
  EXCHANGE
  CUSTOM
}

model Expense {
  id                 String            @id
  ledger             Ledger            @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ledgerId           String
  // Nullable so pre-ownership expenses and expenses whose creator account was
  // deleted remain preserved. Null-owned expenses are admin-managed.
  createdByAccount   Account?          @relation("ExpenseCreator", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByAccountId String?
  // Canonical expense instant. Its wall-clock representation is interpreted
  // using expenseTimeZone; the name is retained for API compatibility.
  expenseDate        DateTime          @db.Timestamptz(0)
  expenseTimeZone    String
  title              String
  // Descriptive id from the in-code category list, e.g. "general",
  // "payment", "movies". See `packages/domain/src/categories.ts`.
  categoryId         String            @default("general")
  // Normalized amount in ledger base-currency minor units.
  amount             Int
  // Present when conversionSource is set: input amount + currency + rate.
  originalAmount     Int?
  originalCurrency   String?
  conversionRate     Float?
  // EXCHANGE (provider) or CUSTOM (user rate). Null = same currency.
  conversionSource   ConversionSource?
  paidBySplitMode    SplitMode         @default(BY_AMOUNT)
  paidByList         ExpensePaidBy[]
  paidFor            ExpensePaidFor[]
  splitMode          SplitMode         @default(EVENLY)
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  documents          ExpenseDocument[]
  notes              String?
  assistantRequestId String?           @unique

  recurringSeriesId  String?
  recurrenceSequence Int?
  recurringSeries    RecurringExpenseSeries?   @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  items              ExpenseItem[]
  itemizedRemainder  ExpenseItemizedRemainder?
  comments           ExpenseComment[]
  fileImportSource   ExpenseFileImportSource?

  @@unique([recurringSeriesId, recurrenceSequence])
  // ledgerId prefix covers group-scoped scans; expenseDate supports
  // recency-bounded currency recommendation queries and intraday sorting.
  @@index([ledgerId, expenseDate])
  @@index([ledgerId, createdAt])
  @@index([createdByAccountId])
  @@index([ledgerId, amount])
  @@index([ledgerId, expenseDate, amount])
  // Prefer-source amount lookup for file-import duplicate detection:
  // bank amounts are in source currency (originalAmount/originalCurrency).
  @@index([ledgerId, originalCurrency, originalAmount])
  @@index([recurringSeriesId, recurrenceSequence])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Expense_title_trgm_idx")
}

// ---------------------------------------------------------------------------
// File-import provenance (CSV-only for now, extensible via `provider`).
//
// Optional 1-1 side table: a row exists only for expenses created via file
// import, so the main Expense model stays clean. All keys here are immutable:
// they survive user edits of title/date/amount, which is what makes exact
// re-import detection work. Fuzzy duplicate detection queries the live
// Expense columns (title/date/amount, trigram index) and therefore sees
// manual expenses too. Matches are advisory only (API/UI flags, no DB
// unique constraints) so intentional duplicates remain possible.
model ExpenseFileImportSource {
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String  @id
  // Denormalized scope key so all lookups stay ledger-scoped via index.
  ledgerId  String

  // Import provider namespace. Only GENERIC_CSV is produced today; other
  // future sources get their own value instead of new columns on Expense.
  provider String @default("GENERIC_CSV")
  // Immutable replay key: sha256("spliit:expense-file-import:v3" + ledgerId + originFingerprint).
  importKey String
  // Hash-only bank identity: sha256("spliit:expense-file-identity:v1" +
  // normalized source account + normalized bank transaction id). Raw bank
  // ids are never stored — the client sends them per request, the server
  // hashes at the boundary, and lookups match on the hash. Null when the
  // export provides no transaction id (no bank-id matching for that row).
  externalIdentityHash String?

  // One-way debug/forensic hashes (never raw source data).
  semanticHash String
  rawHash      String

  // Extensible import context without future migrations,
  // e.g. { fileName, mappingVersion, rowNumber }.
  meta Json?

  importedByAccountId String?
  createdAt           DateTime @default(now())

  @@index([ledgerId, importKey])
  // The bank-id lookup (`findExpenseFileImportDuplicates`: ledgerId +
  // provider + externalIdentityHash IN …) is served by the index below.
  @@index([ledgerId, provider, externalIdentityHash], map: "ExpenseFileImportSource_ledgerId_provider_extIdHash_idx")
}

model ExpenseDocument {
  id          String   @id
  url         String
  fileName    String?
  contentType String?
  width       Int?
  height      Int?
  Expense     Expense? @relation(fields: [expenseId], references: [id])
  expenseId   String?
  Ledger      Ledger   @relation("LedgerDocuments", fields: [ledgerId], references: [id])
  ledgerId    String

  @@index([ledgerId])
}

enum SplitMode {
  EVENLY
  BY_SHARES
  BY_PERCENTAGE
  BY_AMOUNT
  ITEMIZED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceEndType {
  INDEFINITE
  COUNT
  DATE
}

enum RecurringExpenseSeriesStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model RecurringExpenseSeries {
  id                    String                       @id
  ledger                Ledger                       @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ledgerId              String
  creatorAccount        Account?                     @relation("RecurringExpenseSeriesCreator", fields: [creatorAccountId], references: [id], onDelete: SetNull)
  creatorAccountId      String?
  // Immutable scheduling timezone captured from the expense's timezone at creation.
  timeZone              String
  anchorTimeMinutes     Int
  frequency             RecurrenceFrequency
  interval              Int
  anchorDate            DateTime                     @db.Date
  anchorSequence        Int                          @default(1)
  nextOccurrenceDate    DateTime                     @db.Date
  nextOccurrenceOrdinal Int                          @default(2)
  endType               RecurrenceEndType            @default(INDEFINITE)
  occurrenceLimit       Int?
  endDate               DateTime?                    @db.Date
  occurrencesCreated    Int                          @default(1)
  status                RecurringExpenseSeriesStatus @default(ACTIVE)
  /// [RecurringExpenseTemplate]
  template              Json
  /// [RecurringExpenseCatchUpBatch] Persisted notification coalescing state.
  catchUpBatch          Json?
  version               Int                          @default(1)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  expenses              Expense[]

  @@index([ledgerId, status, nextOccurrenceDate])
  @@index([ledgerId, anchorDate])
}

model ExpensePaidFor {
  expense             Expense           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  ledgerParticipant   LedgerParticipant @relation(fields: [ledgerParticipantId], references: [id], onDelete: Restrict)
  expenseId           String
  ledgerParticipantId String
  // Units depend on the owning split mode:
  //   - BY_PERCENTAGE: basis points (10000 = 100%)
  //   - BY_AMOUNT / ITEMIZED: currency minor units
  //   - BY_SHARES: fixed share units (100 = 1 displayed share)
  //   - EVENLY: ignored / inclusion marker
  shares              Int               @default(100)

  @@id([expenseId, ledgerParticipantId])
  @@index([ledgerParticipantId])
}

model ExpensePaidBy {
  expense             Expense           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  ledgerParticipant   LedgerParticipant @relation(fields: [ledgerParticipantId], references: [id], onDelete: Restrict)
  expenseId           String
  ledgerParticipantId String
  // Units depend on the owning paidBySplitMode — see ExpensePaidFor.shares.
  shares              Int               @default(100)

  @@id([expenseId, ledgerParticipantId])
  @@index([ledgerParticipantId])
}

model ExpenseItem {
  id        String               @id
  expense   Expense              @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String
  title     String
  unitPrice Int
  quantity  Int
  amount    Int
  splitMode SplitMode            @default(EVENLY)
  notes     String?
  paidFor   ExpenseItemPaidFor[]
  createdAt DateTime             @default(now())

  @@index([expenseId])
}

model ExpenseItemPaidFor {
  expenseItem         ExpenseItem       @relation(fields: [expenseItemId], references: [id], onDelete: Cascade)
  expenseItemId       String
  ledgerParticipant   LedgerParticipant @relation(fields: [ledgerParticipantId], references: [id], onDelete: Restrict)
  ledgerParticipantId String
  shares              Int

  @@id([expenseItemId, ledgerParticipantId])
}

model ExpenseItemizedRemainder {
  expense   Expense                           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String                            @id
  splitMode SplitMode                         @default(EVENLY)
  paidFor   ExpenseItemizedRemainderPaidFor[]
}

model ExpenseItemizedRemainderPaidFor {
  remainder           ExpenseItemizedRemainder @relation(fields: [expenseId], references: [expenseId], onDelete: Cascade)
  expenseId           String
  ledgerParticipant   LedgerParticipant        @relation(fields: [ledgerParticipantId], references: [id], onDelete: Restrict)
  ledgerParticipantId String
  shares              Int

  @@id([expenseId, ledgerParticipantId])
}

model Activity {
  id       String   @id
  ledger   Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ledgerId String
  time     DateTime @default(now())

  // Imported per-expense audit rows can be retained without flooding the
  // current group activity feed; summary activities remain visible.
  visibleInGroupFeed Boolean @default(true)

  /// ![ActivityType]
  type String

  /// ![ActivityActorType]
  actorType String?
  actorId   String?

  /// ![ActivitySubjectType]
  subjectType String?
  subjectId   String?

  /// [ActivityData]
  data Json?

  // Comment activities are linked to their comment so deleting an expense
  // (and its comments) also removes the corresponding activity rows.
  expenseCommentId       String?                @unique
  expenseComment         ExpenseComment?        @relation("ExpenseCommentActivity", fields: [expenseCommentId], references: [id], onDelete: Cascade)
  notificationDeliveries NotificationDelivery[]

  @@index([ledgerId, time])
  @@index([ledgerId, visibleInGroupFeed, time])
  @@index([ledgerId, type, time])
  @@index([subjectType, subjectId])
}

model NotificationDelivery {
  id                 String    @id
  eventKey           String
  activityId         String?
  activity           Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  recipientAccountId String
  recipientAccount   Account   @relation(fields: [recipientAccountId], references: [id], onDelete: Cascade)
  category           String
  channel            String
  targetKey          String
  pushSubscriptionId String?
  status             String    @default("PENDING")
  snapshotVersion    Int       @default(1)
  snapshot           Json
  attemptCount       Int       @default(0)
  lastAttemptAt      DateTime?
  leaseToken         String?   @unique
  leaseJobId         String?
  leaseExpiresAt     DateTime?
  lastErrorKind      String?
  lastErrorCode      String?
  lastProviderStatus Int?
  lastErrorMessage   String?   @db.Text
  lastErrorAt        DateTime?
  sentAt             DateTime?
  terminalAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([eventKey, recipientAccountId, channel, targetKey])
  @@index([status, leaseExpiresAt])
  @@index([status, terminalAt])
  @@index([recipientAccountId])
  @@index([activityId])
  @@index([eventKey])
}

model ExpenseComment {
  id        String  @id
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String

  // Nullable by design: account deletion preserves the comment and its
  // authorName snapshot while clearing this relation.
  authorAccount   Account? @relation(fields: [authorAccountId], references: [id], onDelete: SetNull)
  authorAccountId String?
  authorName      String
  text            String   @db.Text
  createdAt       DateTime @default(now())

  activity Activity? @relation("ExpenseCommentActivity")

  @@index([expenseId, createdAt])
  @@index([authorAccountId])
}
