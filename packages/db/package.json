{
  "name": "@spliit/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dmmf": "./src/dmmf.ts"
  },
  "scripts": {
    "check-formatting": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "format": "oxfmt .",
    "lint": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives --fix .",
    "prisma-create-migration": "prisma migrate dev",
    "prisma-generate": "prisma generate --schema prisma/schema.prisma",
    "prisma-migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "test": "vitest run src"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@spliit/domain": "workspace:*",
    "dotenv": "^17.4.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@spliit/config": "workspace:*",
    "@types/node": "24.13.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "prisma-json-types-generator": "^5.1.1",
    "prisma-mock": "^1.1.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
