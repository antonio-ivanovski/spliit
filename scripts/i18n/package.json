{
  "name": "@spliit/i18n-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Internal CLI/lib for editing apps/web/src/messages JSON files. en-US is the source of truth.",
  "type": "module",
  "scripts": {
    "check-formatting": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "cli": "bun src/cli.ts",
    "format": "oxfmt .",
    "lint": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives --fix .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "vitest": "^5.0.0"
  }
}
